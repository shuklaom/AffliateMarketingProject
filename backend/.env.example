# Copy this file to .env and fill in your values.
# The Spring Boot app reads these via OS environment variables.

# ── Server ────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── MySQL ─────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/everydaydeals?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to localhost:3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000
